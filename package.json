{
  "name": "tiki_iot",
  "version": "1.0.0",
  "description": "Tiki IoT is an app focused on real-time monitoring and managing IoT devices (temperature sensors, energy meters, etc)",
  "main": "index.js",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "compile": "tsc",
    "install-client": "cd tiki_client && npm install",
    "build-client": "cd tiki_client && npm run build",
    "deploy-client":"mv ./tiki_client/build ./dist",
    "postinstall": "npm run compile && npm run install-client && npm run build-client && npm run deploy-client",
    "start": "node dist/app.js",
    "dev": "nodemon dist/app.js",
    "test": "jest ./dist/__test__",
    "watch-ts": "tsc -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcoCiau/tiki.git"
  },
  "author": "marco ciau",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MarcoCiau/tiki/issues"
  },
  "homepage": "https://github.com/MarcoCiau/tiki#readme",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.4.0",
    "express-validator": "^6.14.0",
    "helmet": "^5.1.0",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.2.0",
    "node-cron": "^3.0.0",
    "socket.io": "^4.5.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^28.1.2",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/node-cron": "^3.0.1",
    "@types/supertest": "^2.0.12",
    "jest": "^28.1.1",
    "supertest": "^6.2.3",
    "ts-jest": "^28.0.5",
    "ts-node": "^10.8.1",
    "typescript": "^4.5.5"
  }
}
